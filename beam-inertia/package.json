{
  "name": "@splicewire/beam-inertia",
  "version": "0.1.3",
  "description": "Packaged Beam defaults for Laravel Inertia hosts: authentication, realms, editor and operator desktop.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/splicewire/beam.git",
    "directory": "beam-inertia"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:imports": "node scripts/check-imports.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@inertiajs/core": "^3.0.0",
    "@inertiajs/react": "^3.0.0",
    "@laravel/passkeys": "^0.2.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@schemastud/frame": "^0.2.0",
    "@schemastud/mainframe": "0.1.0",
    "@schemastud/seam": "0.2.1",
    "@schemastud/ui": "^0.1.1",
    "@splicewire/beam-accounts": "^0.1.1",
    "@splicewire/beam-mainframe": "0.1.1",
    "@splicewire/beam-ux": "^0.2.1 || ^0.3.0",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "react": "^19.2.0",
    "react-router": "^7.0.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "dependencies": {
    "@splicewire/beam-resources": "^0.1.1"
  }
}
