{
    "name": "@splicewire/beam-workflows",
    "version": "0.4.2",
    "description": "The workflows-domain beam surfaces, authored pre-packaged and DTO-first (rehome-components, ADR-0092). Mirrors the PHP splicewire/laravel-beam-workflows package by domain. Ships the workflows administration surface — lineage admin, the schema-driven blueprint editor, the read-only diff/graph previews, the recipient picker, the marking-migration wizard, and the runtime lifecycle Stepper — as portable, tenancy-agnostic components: they own their react-query data logic, take their transport + real-time subscription + feedback + host chrome as injected services (never app-local imports), and type off the generated Workflow* projections delivered via @splicewire/beam-resources. Generic UI comes from the @schemastud/ui foundation; @xyflow/react is a host-provided peer.",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./action-form": {
            "types": "./dist/action-form.d.ts",
            "import": "./dist/action-form.js"
        },
        "./messages": "./messages.default.json",
        "./messages.js": {
            "types": "./messages.default.d.ts",
            "default": "./messages.default.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "README.md",
        "messages.default.json",
        "messages.default.js",
        "messages.default.d.ts"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/splicewire/beam.git",
        "directory": "beam-workflows"
    },
    "scripts": {
        "build": "tsup && pnpm run test:node",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:node": "node scripts/node-smoke.mjs",
        "typecheck": "tsc --noEmit",
        "lint:imports": "node scripts/check-imports.mjs",
        "prepublishOnly": "pnpm run build",
        "build:action-form": "tsup --config tsup.action-form.config.ts",
        "messages:catalog": "node scripts/messages-catalog.mjs",
        "messages:catalog:write": "node scripts/messages-catalog.mjs --write"
    },
    "schemastud": {
        "messages": {
            "version": 1,
            "catalog": "./messages"
        }
    },
    "peerDependencies": {
        "@schemastud/messages": "^0.1.0 || ^0.2.0",
        "@schemastud/ui": "*",
        "@tanstack/react-query": ">=5",
        "@xyflow/react": ">=12",
        "lucide-react": ">=0.400.0",
        "react": ">=18"
    },
    "devDependencies": {
        "@schemastud/messages": "github:schemastud/js#47810c9e78aca3eb452f7b34a1eaaed909f4102c&path:/messages",
        "@schemastud/ui": "github:schemastud/js#abef468b39df9b1e81fd9a2081e69f8094c60e4e&path:/ui",
        "@tanstack/react-query": "^5.62.0",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/node": "^22.20.1",
        "@types/react": "^19.0.0",
        "@xyflow/react": "^12.4.0",
        "jsdom": "^25.0.1",
        "lucide-react": "^0.468.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tsup": "^8.5.1",
        "typescript": "^5.7.2",
        "vitest": "^4.1.10",
        "@splicewire/beam-resources": "file:../beam-resources"
    },
    "dependencies": {
        "@splicewire/beam-resources": "^0.5.0"
    }
}
