{
    "name": "@splicewire/beam-notifications",
    "version": "0.1.0",
    "description": "The notifications-domain beam surfaces (attention-surfaces 11; decision 02). Mirrors the PHP splicewire/laravel-beam-notifications package by domain. Ships the bell: one popover whose 'Recent' section lists the reader's newest stored notifications, with an optional 'Needs you' slot and count a host fills (tower-ux fills it with Review). It renders inside the host realm's Frame kit (no provider of its own) and reads the `notifications` resource's list and summary, and runs its declared mark-read actions, through that kit's transport.",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./messages": "./messages.default.json",
        "./messages.js": {
            "types": "./messages.default.d.ts",
            "default": "./messages.default.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "README.md",
        "messages.default.json",
        "messages.default.js",
        "messages.default.d.ts"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/splicewire/beam.git",
        "directory": "beam-notifications"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "pnpm run build",
        "messages:catalog": "node scripts/messages-catalog.mjs",
        "messages:catalog:write": "node scripts/messages-catalog.mjs --write"
    },
    "schemastud": {
        "messages": {
            "version": 1,
            "catalog": "./messages"
        }
    },
    "peerDependencies": {
        "@schemastud/frame": "*",
        "@schemastud/messages": "^0.1.0 || ^0.2.0",
        "@schemastud/ui": "^0.1.2 || ^0.2.0 || ^0.3.0",
        "@tanstack/react-query": ">=5",
        "lucide-react": ">=0.400.0",
        "react": ">=18"
    },
    "devDependencies": {
        "@schemastud/frame": "github:schemastud/js#9503dcf4d839c269ee6053a6a421800bbbb7f974&path:/frame",
        "@schemastud/messages": "github:schemastud/js#47810c9e78aca3eb452f7b34a1eaaed909f4102c&path:/messages",
        "@schemastud/ui": "github:schemastud/js#abef468b39df9b1e81fd9a2081e69f8094c60e4e&path:/ui",
        "@tanstack/react-query": "^5.62.0",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/react": "^19.0.0",
        "jsdom": "^25.0.1",
        "lucide-react": "^0.468.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-remove-scroll": "2.7.2",
        "react-remove-scroll-bar": "2.3.8",
        "react-style-singleton": "2.2.3",
        "tsup": "^8.5.1",
        "typescript": "^5.7.2",
        "use-callback-ref": "1.3.3",
        "use-sidecar": "1.1.3",
        "vitest": "^4.1.10"
    }
}
