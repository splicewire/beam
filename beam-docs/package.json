{
  "name": "@splicewire/beam-docs",
  "version": "0.5.3",
  "description": "Optional Beam documentation, Scalar API reference and release publication controls.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/splicewire/beam.git",
    "directory": "beam-docs"
  },
  "scripts": {
    "build": "tsup && pnpm run test:types",
    "dev": "tsup --watch",
    "test": "pnpm run contracts:check && vitest run",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node --test scripts/contracts.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc --project tests/consumer/tsconfig.json",
    "prepublishOnly": "pnpm run contracts:check && pnpm run build"
  },
  "peerDependencies": {
    "@inertiajs/react": ">=2",
    "@rjsf/utils": ">=6",
    "@schemastud/combobox": "*",
    "@schemastud/frame": "*",
    "@schemastud/nav": "*",
    "@schemastud/seam": "*",
    "@splicewire/beam-mdx": "*",
    "@splicewire/beam-ux": ">=0.3.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@inertiajs/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inertiajs/react": "^3.0.0",
    "@rjsf/utils": "^6.0.0",
    "@schemastud/combobox": "github:schemastud/js#921e870797f2506ddf3c06721dea84c2901c18d7&path:/combobox",
    "@schemastud/frame": "github:schemastud/js#9503dcf4d839c269ee6053a6a421800bbbb7f974&path:/frame",
    "@schemastud/nav": "github:schemastud/js#ea1bb1a06d83de66164e19f9b6798342ed2a8c51&path:/nav",
    "@schemastud/seam": "github:schemastud/js#aae63180fd740d3a9497fa2a12e7fbc7c206bc92&path:/seam",
    "@splicewire/beam-ux": "github:splicewire/beam#0476d7f882372e542fa682b1ab11b4234dbe2c6d&path:/beam-ux",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.475.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
