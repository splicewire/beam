{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "version": {
            "type": "string",
            "title": "Release version",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*(?![\\s\\S])"
        }
    },
    "required": [
        "version"
    ],
    "$id": "PublishInputData"
}
