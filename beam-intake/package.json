    "react": ">=18"
  },
  "devDependencies": {
    "@schemastud/ui": "github:schemastud/js#09abbd00e4be30694dc49518ece40987b3e17086&path:/ui",
    "@schemastud/seam": "github:schemastud/js#72b9e79d72e3dbd9a14113988c67b72f065a5b87&path:/seam",
    "@tanstack/react-query": "^5.62.0",
