    "react": ">=18"
  },
  "devDependencies": {
    "@schemastud/frame": "github:schemastud/js#0f274f7677d874b3eaa2e0225e81bbbabbdc6349&path:/frame",
    "@schemastud/ui": "github:schemastud/js#abef468b39df9b1e81fd9a2081e69f8094c60e4e&path:/ui",
    "@schemastud/seam": "github:schemastud/js#8ac277bd74a944a96a936c12b7a792e8e647ce22&path:/seam",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/node": "^22.20.1",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
