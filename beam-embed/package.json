{
  "name": "@splicewire/beam-embed",
  "version": "0.1.12",
  "description": "Portable embed privacy and retention controls.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./messages": "./messages.default.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "messages.default.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "messages:catalog": "node scripts/messages-catalog.mjs",
    "messages:catalog:write": "node scripts/messages-catalog.mjs --write"
  },
  "schemastud": {
    "messages": {
      "version": 1,
      "catalog": "./messages"
    }
  },
  "dependencies": {
    "@splicewire/beam-resources": "github:splicewire/beam#d4c60c05cf9658febc401d1634c2a6c9fb917516&path:/beam-resources"
  },
  "peerDependencies": {
    "@schemastud/messages": "^0.1.0 || ^0.2.0",
    "@schemastud/ui": "*",
    "@tanstack/react-query": ">=5",
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@schemastud/messages": "github:schemastud/js#dce5c5713186802da28624b6db069b4b3f31ea07&path:/messages",
    "react-remove-scroll-bar": "2.3.8",
    "react-remove-scroll": "2.7.2",
    "react-style-singleton": "2.2.3",
    "use-callback-ref": "1.3.3",
    "use-sidecar": "1.1.3",
    "@schemastud/ui": "github:schemastud/js#85adf3d498a76c2a993cfbbe03281a9225d8b853&path:/ui",
    "@splicewire/beam-resources": "github:splicewire/beam#d4c60c05cf9658febc401d1634c2a6c9fb917516&path:/beam-resources",
    "@testing-library/react": "^16.1.0",
    "@testing-library/dom": "^10.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
