{
    "name": "@splicewire/beam-ux",
    "version": "0.1.0",
    "description": "The beam UX-builder surfaces, authored pre-packaged and DTO-first (rehome-ui, ADR-0116). Mirrors the PHP splicewire/laravel-beam-ux package by domain. Ships the in-app visual editing surface for a beam site's OWN front-end — the docked region inspector, the floating in-context overlay editor, the live region canvas, and the layout›template›page composition structure panel with its component palette — as portable, tenancy-agnostic components: they own their react-query data logic, take their transport + feedback as injected services (never app-local imports), and type off the generated BeamUxEntryBody projection delivered via @splicewire/_resources. Generic UI comes from the @schemastud/ui foundation; the schema-driven form editor is the real @schemastud/seam SchemaForm, a host-provided peer.",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./blockdoc": {
            "types": "./dist/blockdoc.d.ts",
            "import": "./dist/blockdoc.js"
        },
        "./blockdoc/json": {
            "types": "./dist/blockdoc/json.d.ts",
            "import": "./dist/blockdoc/json.js"
        },
        "./canvas": {
            "types": "./dist/canvas.d.ts",
            "import": "./dist/canvas.js"
        },
        "./leaf": {
            "types": "./dist/leaf.d.ts",
            "import": "./dist/leaf.js"
        },
        "./site": {
            "types": "./dist/site.d.ts",
            "import": "./dist/site.js"
        },
        "./docs": {
            "types": "./dist/docs.d.ts",
            "import": "./dist/docs.js"
        },
        "./pages": {
            "types": "./dist/pages.d.ts",
            "import": "./dist/pages.js"
        },
        "./account": {
            "types": "./dist/account.d.ts",
            "import": "./dist/account.js"
        },
        "./shell": {
            "types": "./dist/shell.d.ts",
            "import": "./dist/shell.js"
        },
        "./desk": {
            "types": "./dist/desk.d.ts",
            "import": "./dist/desk.js"
        },
        "./appshell": {
            "types": "./dist/appshell.d.ts",
            "import": "./dist/appshell.js"
        },
        "./nav": {
            "types": "./dist/nav.d.ts",
            "import": "./dist/nav.js"
        },
        "./surgeon": {
            "types": "./dist/surgeon.d.ts",
            "import": "./dist/surgeon.js"
        },
        "./streaming": {
            "types": "./dist/streaming.d.ts",
            "import": "./dist/streaming.js"
        },
        "./admin": {
            "types": "./dist/admin.d.ts",
            "import": "./dist/admin.js"
        }
    },
    "sideEffects": false,
    "bin": {
        "beam-ux-sdk-hook-migration": "bin/sdk-hook-migration.mjs",
        "beam-ux-namespace-rename": "bin/namespace-rename.mjs"
    },
    "files": [
        "dist",
        "src",
        "bin",
        "README.md"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/splicewire/beam.git",
        "directory": "beam-ux"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint:imports": "node scripts/check-imports.mjs",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@babel/parser": "^7.29.7",
        "@babel/types": "^7.29.7",
        "@splicewire/_resources": "file:../../splicewire/_resources",
        "recast": "^0.23.12"
    },
    "peerDependencies": {
        "@inertiajs/react": ">=2",
        "@rjsf/core": ">=6",
        "@rjsf/shadcn": ">=6",
        "@rjsf/utils": ">=6",
        "@rjsf/validator-ajv8": ">=6",
        "@schemastud/chat": "*",
        "@schemastud/frame": "*",
        "@schemastud/mainframe": "*",
        "@schemastud/nav": "*",
        "@schemastud/seam": "*",
        "@schemastud/ui": "*",
        "@tanstack/react-query": ">=5",
        "lucide-react": ">=0.400.0",
        "react": ">=18",
        "zustand": ">=4"
    },
    "peerDependenciesMeta": {
        "@schemastud/chat": {
            "optional": true
        },
        "@schemastud/mainframe": {
            "optional": true
        },
        "@schemastud/nav": {
            "optional": true
        }
    },
    "devDependencies": {
        "@inertiajs/react": "^3.0.0",
        "@schemastud/chat": "file:../../schemastud/chat",
        "@schemastud/frame": "file:../../schemastud/frame",
        "@schemastud/mainframe": "file:../../schemastud/mainframe",
        "@schemastud/nav": "file:../../schemastud/nav",
        "@schemastud/seam": "file:../../schemastud/seam",
        "@schemastud/ui": "file:../../schemastud/ui",
        "@tanstack/react-query": "^5.62.0",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/node": "^22.20.1",
        "@types/react": "^19.0.0",
        "jsdom": "^25.0.1",
        "lucide-react": "^0.468.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-rnd": "^10.5.3",
        "tsup": "^8.5.1",
        "typescript": "^5.7.2",
        "vitest": "^4.1.10"
    }
}
