{
  "name": "@splicewire/beam-transforms",
  "version": "0.3.0",
  "description": "The transforms-domain beam surface (popcorn-runner-substrate ticket 09, ADR-0116/0141): the RunnerTransform authoring editor for sandboxed, user-authored transforms. Authored pre-packaged and DTO-first — it owns its react-query data logic, takes its transport + feedback as injected services (never app-local imports), and types off the RunnerTransform wire shape. Generic UI comes from the @schemastud/ui foundation.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./messages": "./messages.default.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "messages.default.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/splicewire/beam.git",
    "directory": "beam-transforms"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:imports": "node scripts/check-imports.mjs",
    "prepublishOnly": "pnpm run build",
    "messages:catalog": "node scripts/messages-catalog.mjs",
    "messages:catalog:write": "node scripts/messages-catalog.mjs --write"
  },
  "schemastud": {
    "messages": {
      "version": 1,
      "catalog": "./messages"
    }
  },
  "peerDependencies": {
    "@schemastud/messages": "^0.1.0 || ^0.2.0",
    "@schemastud/ui": "*",
    "@tanstack/react-query": ">=5",
    "lucide-react": ">=0.400.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@schemastud/messages": "github:schemastud/js#dce5c5713186802da28624b6db069b4b3f31ea07&path:/messages",
    "@schemastud/ui": "github:schemastud/js#85adf3d498a76c2a993cfbbe03281a9225d8b853&path:/ui",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
