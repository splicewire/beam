{
  "name": "@splicewire/beam-accounts",
  "version": "0.6.0",
  "description": "The accounts-domain beam surfaces, authored pre-packaged and DTO-first (rehome-components, ADR-0092). Mirrors the PHP splicewire/laravel-beam-accounts package by domain. Ships the API-keys / tokens management surface as a portable, tenancy-agnostic component: it owns its react-query data logic, takes its transport + feedback + host chrome as injected services (never app-local imports), and types off the generated ApiTokenData projection delivered via @splicewire/beam-resources. Generic UI comes from the @schemastud/ui foundation.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    },
    "./messages": "./messages.default.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "messages.default.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/splicewire/beam.git",
    "directory": "beam-accounts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:imports": "node scripts/check-imports.mjs",
    "prepublishOnly": "pnpm run build",
    "messages:catalog": "node scripts/messages-catalog.mjs",
    "messages:catalog:write": "node scripts/messages-catalog.mjs --write"
  },
  "schemastud": {
    "messages": {
      "version": 1,
      "catalog": "./messages"
    }
  },
  "dependencies": {
    "@splicewire/beam-resources": "github:splicewire/beam#d9b706ae76f50ab39aa2cd835713794582de774a&path:/beam-resources"
  },
  "peerDependencies": {
    "@schemastud/messages": "^0.1.0 || ^0.2.0",
    "@schemastud/ui": "^0.1.2 || ^0.2.0 || ^0.3.0",
    "@tanstack/react-query": ">=5",
    "@tanstack/react-table": ">=8",
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "@schemastud/seam": ">=0.2.2",
    "@splicewire/beam-ux": "^0.6.0 || ^0.7.0 || ^0.8.0 || ^0.9.0 || ^0.10.0 || ^0.11.0 || ^0.12.0 || ^0.13.0 || ^0.14.0 || ^0.15.0 || ^0.16.0 || ^0.17.0 || ^0.18.0",
    "@schemastud/combobox": ">=0.1.0",
    "@schemastud/frame": "*",
    "@splicewire/beam-agreements": "*"
  },
  "peerDependenciesMeta": {
    "@splicewire/beam-agreements": {
      "optional": true
    }
  },
  "devDependencies": {
    "@schemastud/messages": "github:schemastud/js#dce5c5713186802da28624b6db069b4b3f31ea07&path:/messages",
    "@schemastud/frame": "github:schemastud/js#3f927322b2664159cd32bb1e8df702bfc921fce7&path:/frame",
    "react-remove-scroll-bar": "2.3.8",
    "react-remove-scroll": "2.7.2",
    "react-style-singleton": "2.2.3",
    "use-callback-ref": "1.3.3",
    "use-sidecar": "1.1.3",
    "@schemastud/ui": "github:schemastud/js#85adf3d498a76c2a993cfbbe03281a9225d8b853&path:/ui",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "@schemastud/seam": "github:schemastud/js#ceaa0076c1e444a311e72bbef0f379e40e91d4fe&path:/seam",
    "@splicewire/beam-resources": "github:splicewire/beam#d9b706ae76f50ab39aa2cd835713794582de774a&path:/beam-resources",
    "@splicewire/beam-ux": "github:splicewire/beam#144d8b41c70e7b245ad1fee86a1a396821c638bb&path:/beam-ux",
    "@splicewire/beam-agreements": "github:splicewire/beam#421ebd500c5e063a442b619e5c1d76a62f4bf9d0&path:/beam-agreements",
    "@schemastud/combobox": "github:schemastud/js#9d4997753a6c0a241534453cffdc0ee00c494077&path:/combobox"
  }
}
