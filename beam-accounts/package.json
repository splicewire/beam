{
  "name": "@splicewire/beam-accounts",
  "version": "1.0.0",
  "description": "The accounts-domain beam surfaces, authored pre-packaged and DTO-first (rehome-components, ADR-0092). Mirrors the PHP splicewire/laravel-beam-accounts package by domain. Ships the API-keys / tokens management surface as a portable, tenancy-agnostic component: it owns its react-query data logic, takes its transport + feedback + host chrome as injected services (never app-local imports), and types off the generated ApiTokenData projection delivered via @splicewire/beam-resources. Generic UI comes from the @schemastud/ui foundation.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/splicewire/beam.git",
    "directory": "beam-accounts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:imports": "node scripts/check-imports.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@splicewire/beam-resources": "^0.1.3"
  },
  "peerDependencies": {
    "@schemastud/ui": "^0.1.2",
    "@tanstack/react-query": ">=5",
    "@tanstack/react-table": ">=8",
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "@schemastud/seam": ">=0.2.2",
    "@splicewire/beam-ux": "^0.8.0"
  },
  "devDependencies": {
    "react-remove-scroll-bar": "2.3.8",
    "react-remove-scroll": "2.7.2",
    "react-style-singleton": "2.2.3",
    "use-callback-ref": "1.3.3",
    "use-sidecar": "1.1.3",
    "@schemastud/ui": "file:../../schemastud/ui",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "@schemastud/seam": "file:../../schemastud/seam",
    "@splicewire/beam-resources": "file:../beam-resources",
    "@splicewire/beam-ux": "file:../beam-ux"
  }
}
