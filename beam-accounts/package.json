{
  "name": "@splicewire/beam-accounts",
  "version": "0.5.8",
  "description": "The accounts-domain beam surfaces, authored pre-packaged and DTO-first (rehome-components, ADR-0092). Mirrors the PHP splicewire/laravel-beam-accounts package by domain. Ships the API-keys / tokens management surface as a portable, tenancy-agnostic component: it owns its react-query data logic, takes its transport + feedback + host chrome as injected services (never app-local imports), and types off the generated ApiTokenData projection delivered via @splicewire/beam-resources. Generic UI comes from the @schemastud/ui foundation.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/splicewire/beam.git",
    "directory": "beam-accounts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:imports": "node scripts/check-imports.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@splicewire/beam-resources": "github:splicewire/beam#d32aa1ba0ff8453b7a212cbeb4fa60e743f5e04c&path:/beam-resources"
  },
  "peerDependencies": {
    "@schemastud/ui": "^0.1.2 || ^0.2.0 || ^0.3.0",
    "@tanstack/react-query": ">=5",
    "@tanstack/react-table": ">=8",
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "@schemastud/seam": ">=0.2.2",
    "@splicewire/beam-ux": "^0.6.0 || ^0.7.0 || ^0.8.0 || ^0.9.0 || ^0.10.0 || ^0.11.0 || ^0.12.0 || ^0.13.0 || ^0.14.0 || ^0.15.0 || ^0.16.0",
    "@schemastud/combobox": ">=0.1.0",
    "@schemastud/frame": "*"
  },
  "devDependencies": {
    "@schemastud/frame": "github:schemastud/js#94e9d7a4aa0336e441ff268874baef1468845dad&path:/frame",
    "react-remove-scroll-bar": "2.3.8",
    "react-remove-scroll": "2.7.2",
    "react-style-singleton": "2.2.3",
    "use-callback-ref": "1.3.3",
    "use-sidecar": "1.1.3",
    "@schemastud/ui": "github:schemastud/js#868f3be704f6af5b4954562edba7533c7a8c5999&path:/ui",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "@schemastud/seam": "github:schemastud/js#c64c71230c3f813a50dc2ebd0c4f14eaa03dabdd&path:/seam",
    "@splicewire/beam-resources": "github:splicewire/beam#d32aa1ba0ff8453b7a212cbeb4fa60e743f5e04c&path:/beam-resources",
    "@splicewire/beam-ux": "github:splicewire/beam#fef55c8d704a892c354e04b01d8600bc2ef8548d&path:/beam-ux",
    "@schemastud/combobox": "github:schemastud/js#23d6f448bc981db6d6b86baecbc0f3902cb342eb&path:/combobox"
  }
}
