{
    "name": "@splicewire/beam-ingest",
    "version": "0.1.0",
    "description": "Portable progress for accepted ingest runs, typed from the generated IngestRunData projection.",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/splicewire/beam.git",
        "directory": "beam-ingest"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint:imports": "node scripts/check-imports.mjs",
        "prepublishOnly": "pnpm run build"
    },
    "dependencies": {
        "@splicewire/_resources": "git+https://github.com/splicewire/_resources.git#33be024a9c5386f0a18bd8f928cc092485a12346"
    },
    "peerDependencies": {
        "@schemastud/ui": "*",
        "@tanstack/react-query": ">=5",
        "react": ">=18"
    },
    "devDependencies": {
        "@schemastud/ui": "github:schemastud/js#abef468b39df9b1e81fd9a2081e69f8094c60e4e&path:/ui",
        "@tanstack/react-query": "^5.62.0",
        "@testing-library/react": "^16.1.0",
        "@types/node": "^22.20.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "jsdom": "^25.0.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tsup": "^8.5.1",
        "typescript": "^5.7.2",
        "vitest": "^4.1.10"
    }
}
