{
  "name": "beam",
  "private": true,
  "type": "module",
  "description": "The beam app-substrate package family — one pnpm workspace. App/site-level substrate + capabilities (ADR-0082: beam = substrate), sitting above the schemastud core/tooling layer. Publishes under the @splicewire npm scope (Beam is the free-tier arm of Splicewire).",
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "build": "node scripts/workspaces.mjs run build",
    "dev": "pnpm -r --parallel --if-present run dev",
    "test": "pnpm run test:editor-kit && pnpm run test:build-order && pnpm run test:ownership && node scripts/workspaces.mjs run test",
    "test:ownership": "pnpm --filter ./beam-accounts exec vitest run --root .. tests/account-ownership.test.ts",
    "typecheck": "node scripts/workspaces.mjs run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --url http://127.0.0.1:6007",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "test:editor-kit": "node --test tests/editor-kit-boundary.test.mjs",
    "test:build-order": "node --test tests/workspace-build-order.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@storybook/react-vite": "^10.5.4",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/vite": "^4.3.3",
    "jest-image-snapshot": "^6.5.2",
    "playwright": "^1.61.1",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.3.3"
  },
  "//pnpm.overrides": "Every first-party package resolves to its checkout, as the npm workspace linked them: the beam workspaces in this repo and the schemastud/_resources siblings beside it (~/Workspaces/js/packages). Releases never read these: release-package builds each package alone, from its own manifest, against released versions.",
  "pnpm": {
    "overrides": {
      "@splicewire/beam-resources": "link:beam-resources",
      "@splicewire/beam-ux-canvas": "link:beam-ux-canvas",
      "@splicewire/beam-content": "link:beam-content",
      "@splicewire/beam-ux-prototype": "link:beam-ux-prototype",
      "@splicewire/beam-mainframe": "link:beam-mainframe",
      "@splicewire/beam-workflows": "link:beam-workflows",
      "@splicewire/beam-ux": "link:beam-ux",
      "@splicewire/beam-mdx": "link:beam-mdx",
      "@splicewire/beam-accounts": "link:beam-accounts",
      "@splicewire/beam-docs": "link:beam-docs",
      "@splicewire/beam-market": "link:beam-market",
      "@splicewire/beam-transforms": "link:beam-transforms",
      "@splicewire/beam-calendar": "link:beam-calendar",
      "@splicewire/beam-versioning": "link:beam-versioning",
      "@splicewire/beam-ingest": "link:beam-ingest",
      "@splicewire/beam-intake": "link:beam-intake",
      "@splicewire/beam-inertia": "link:beam-inertia",
      "@splicewire/beam-embed": "link:beam-embed",
      "@schemastud/big-calendar": "link:../schemastud/big-calendar",
      "@schemastud/blockdoc": "link:../schemastud/blockdoc",
      "@schemastud/chat": "link:../schemastud/chat",
      "@schemastud/combobox": "link:../schemastud/combobox",
      "@schemastud/frame": "link:../schemastud/frame",
      "@schemastud/mainframe": "link:../schemastud/mainframe",
      "@schemastud/nav": "link:../schemastud/nav",
      "@schemastud/seam": "link:../schemastud/seam",
      "@schemastud/ui": "link:../schemastud/ui",
      "@splicewire/_resources": "link:../splicewire/_resources"
    }
  }
}
