{
    "name": "@splicewire/beam-versioning",
    "version": "0.1.0",
    "description": "The version-history beam surface, authored pre-packaged and DTO-first (rehome-components, ADR-0116; ADR-0092 vendor seam). Mirrors the PHP splicewire/laravel-beam-versioning package. Ships the record-agnostic version-history UI extracted from the composition VersionsDrawer: VersionsList, VersionRestoreDialog, and relativeTime — typed off the record-agnostic VersionData shape, owning its react-query data logic, taking transport + feedback + host chrome as injected services (never app-local imports). Generic UI comes from the @schemastud/ui foundation.",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/splicewire/beam.git",
        "directory": "beam-versioning"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint:imports": "node scripts/check-imports.mjs",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "@schemastud/ui": "*",
        "@tanstack/react-query": ">=5",
        "lucide-react": ">=0.400.0",
        "react": ">=18"
    },
    "devDependencies": {
        "@schemastud/ui": "file:../../schemastud/ui",
        "@tanstack/react-query": "^5.62.0",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/node": "^22.20.1",
        "@types/react": "^19.0.0",
        "jsdom": "^25.0.1",
        "lucide-react": "^0.468.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tsup": "^8.5.1",
        "typescript": "^5.7.2",
        "vitest": "^4.1.10"
    }
}
