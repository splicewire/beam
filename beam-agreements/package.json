    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    }
  },
  "peerDependencies": {
    "@schemastud/frame": "*",
    "@schemastud/seam": "*",
    "@tanstack/react-query": ">=5",
    "react": ">=18"
  },
  "devDependencies": {
    "@schemastud/frame": "github:schemastud/js#3f927322b2664159cd32bb1e8df702bfc921fce7&path:/frame",
    "@schemastud/seam": "github:schemastud/js#ceaa0076c1e444a311e72bbef0f379e40e91d4fe&path:/seam",
    "@schemastud/ui": "github:schemastud/js#85adf3d498a76c2a993cfbbe03281a9225d8b853&path:/ui",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-remove-scroll": "2.7.2",
    "react-remove-scroll-bar": "2.3.8",
    "react-style-singleton": "2.2.3",
    "tsup": "^8.5.1",
    "use-callback-ref": "1.3.3",
    "use-sidecar": "1.1.3",
    "typescript": "^5.7.2",
